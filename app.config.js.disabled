/** Configuración compatible con Expo CLI y EAS Build en Linux. */
const rawBundleId = "com.app.socialsip";
const bundleId =
  rawBundleId
    .replace(/[-_]/g, ".")
    .replace(/[^a-zA-Z0-9.]/g, "")
    .replace(/\.+/g, ".")
    .replace(/^\.+|\.+$/g, "")
    .toLowerCase()
    .split(".")
    .map((segment) => (/^[a-zA-Z]/.test(segment) ? segment : `x${segment}`))
    .join(".") || "com.app.socialsip";

const config = {
  name: "Tragos Sociales",
  slug: "socialsip",
  owner: "jesus31973479",
  version: "1.0.0",
  orientation: "portrait",
  icon: "./assets/images/icon.png",
  scheme: "socialsip",
  userInterfaceStyle: "automatic",
  newArchEnabled: true,
  ios: {
    supportsTablet: true,
    bundleIdentifier: bundleId,
    infoPlist: {
      ITSAppUsesNonExemptEncryption: false,
      NSLocationWhenInUseUsageDescription: "Tragos Sociales necesita acceso a tu ubicación para mostrar dónde están tus amigos.",
      NSLocationAlwaysAndWhenInUseUsageDescription:
        "Tragos Sociales necesita acceso a tu ubicación mientras usas el mapa y el descubrimiento cercano.",
    },
  },
  android: {
    adaptiveIcon: {
      backgroundColor: "#E6F4FE",
      foregroundImage: "./assets/images/android-icon-foreground.png",
      backgroundImage: "./assets/images/android-icon-background.png",
      monochromeImage: "./assets/images/android-icon-monochrome.png",
    },
    edgeToEdgeEnabled: true,
    predictiveBackGestureEnabled: false,
    package: bundleId,
    scheme: "socialsip",
    permissions: ["POST_NOTIFICATIONS"],
    intentFilters: [
      {
        action: "VIEW",
        data: [{ scheme: "socialsip", host: "auth", pathPrefix: "/callback" }],
        category: ["BROWSABLE", "DEFAULT"],
      },
    ],
  },
  web: {
    bundler: "metro",
    output: "static",
    favicon: "./assets/images/favicon.png",
  },
  extra: {
    appSubtitle: "time to drink",
    eas: { projectId: "f4eb060a-a0e9-4124-9b02-2087982bdd05" },
    supabaseUrl: "https://cymhbwgxmezrwofkbdqz.supabase.co",
    supabaseAnonKey: "sb_publishable_V-Tjv6qV2JaEdXyumlGZ8w_HbdPp7iD",
  },
  plugins: [
    "expo-router",
    "expo-asset",
    "expo-font",
    ["expo-web-browser", { experimentalLauncherActivity: true }],
    "./plugins/with-google-maps-android.js",
    "expo-location",
    "expo-image-picker",
    "expo-document-picker",
    [
      "expo-notifications",
      {
        icon: "./assets/images/android-icon-monochrome.png",
